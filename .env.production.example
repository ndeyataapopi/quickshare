APP_NAME=QuickShare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quickshare.com

LOG_CHANNEL=production
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=quickshare
DB_USERNAME=quickshare_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@quickshare.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Security
SANCTUM_STATEFUL_DOMAINS=quickshare.com,www.quickshare.com
SANCTUM_TOKEN_PREFIX=qs_

# Rate Limiting
THROTTLE_LIMIT=60

# Backup
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7

# Monitoring
MONITORING_ENABLED=true
HEALTH_CHECK_ENABLED=true

# --------------------------------------------------------------------------
# Collexia Payment Provider (Phase 5)
# --------------------------------------------------------------------------
# Production values must be obtained from Collexia onboarding. Leave empty to
# keep Collexia disabled and QuickShare in manual mode.
COLLEXIA_BASE_URL=https://api.collexia.co
COLLEXIA_API_KEY=
COLLEXIA_CLIENT_CODE=
COLLEXIA_WEBHOOK_SECRET=
COLLEXIA_SIGNATURE_HEADER=X-Webhook-Signature
COLLEXIA_SIGNATURE_ALGORITHM=hmac-sha256
COLLEXIA_SANDBOX=false
COLLEXIA_HEALTH_ENDPOINT=
COLLEXIA_DISBURSEMENT_ENDPOINT=/api/v1/payments
COLLEXIA_LENDER_RETURN_ENDPOINT=/api/v1/payments
COLLEXIA_REPAYMENT_ENDPOINT=/api/v1/collections
COLLEXIA_STATUS_CHECK_ENDPOINT=/api/v1/transactions/{reference}

# --------------------------------------------------------------------------
# MobiDebit / MobiPay Namibia Payment Provider (Phase 6)
# --------------------------------------------------------------------------
# Production values must be obtained from MobiDebit/MobiPay onboarding. Leave
# empty to keep MobiDebit disabled and QuickShare in manual mode.
MOBIDEBIT_BASE_URL=https://live.mobipaid.io
MOBIDEBIT_API_KEY=
MOBIDEBIT_SANDBOX=false
MOBIDEBIT_REDIRECT_URL=https://quickshare.com/payment/receipt
MOBIDEBIT_RESPONSE_URL=https://quickshare.com/api/payments/webhooks/mobidebit
MOBIDEBIT_WEBHOOK_SECRET=
MOBIDEBIT_SIGNATURE_HEADER=X-Webhook-Signature
MOBIDEBIT_SIGNATURE_ALGORITHM=hmac-sha256
MOBIDEBIT_HEALTH_ENDPOINT=
MOBIDEBIT_PAYMENT_REQUEST_ENDPOINT=/v2/payment-requests/
MOBIDEBIT_STATUS_CHECK_ENDPOINT=/v2/payment-requests/{reference}

# --------------------------------------------------------------------------
# RealPay Payment Provider (Phase 7)
# --------------------------------------------------------------------------
# Production values must be obtained from RealPay onboarding. Leave empty to
# keep RealPay disabled and QuickShare in manual mode.
REALPAY_BASE_URL=https://api.realpay.co.za
REALPAY_API_KEY=
REALPAY_SANDBOX=false
REALPAY_AUTH_HEADER=X-API-Key
REALPAY_WEBHOOK_SECRET=
REALPAY_SIGNATURE_HEADER=X-Webhook-Signature
REALPAY_SIGNATURE_ALGORITHM=hmac-sha256
REALPAY_HEALTH_ENDPOINT=
REALPAY_COLLECTIONS_ENDPOINT=/api/v1/collections
REALPAY_PAYOUTS_ENDPOINT=/api/v1/payouts
REALPAY_VERIFICATION_ENDPOINT=/api/v1/verifications
REALPAY_STATUS_CHECK_ENDPOINT=/api/v1/transactions/{reference}

# --------------------------------------------------------------------------
# Payment Automation Pilot Configuration (Phase 9)
# --------------------------------------------------------------------------
# Global emergency kill switch. When false, every operation behaves as manual
# regardless of per-operation settings. Leave false until the controlled
# pilot is deliberately started.
PAYMENT_AUTOMATION_ENABLED=false

# Per-operation enablement switches. Enable only one operation at a time
# during the controlled pilot.
LENDER_FUNDING_ENABLED=false
LENDER_FUNDING_METHOD=manual
LENDER_FUNDING_MODE=manual
LENDER_FUNDING_PROVIDER=manual

BORROWER_DISBURSEMENT_ENABLED=false
BORROWER_DISBURSEMENT_METHOD=manual
BORROWER_DISBURSEMENT_MODE=manual
BORROWER_DISBURSEMENT_PROVIDER=manual

BORROWER_REPAYMENT_ENABLED=false
BORROWER_REPAYMENT_METHOD=manual
BORROWER_REPAYMENT_MODE=manual
BORROWER_REPAYMENT_PROVIDER=manual

LENDER_RETURNS_ENABLED=false
LENDER_RETURNS_METHOD=manual
LENDER_RETURNS_MODE=manual
LENDER_RETURNS_PROVIDER=manual
